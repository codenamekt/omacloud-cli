# =============================================================================
# Omacloud CLI — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# =============================================================================

# URL of the Omacloud API instance to talk to.
# During local dev: http://localhost:8000
# Staging / production: https://api.omacloud.org
OMACLOUD_API_URL=https://api.omacloud.org

# Optional: override auth token storage path (default: ~/.omacloud/auth.json)
# OMACLOUD_AUTH_PATH=~/.omacloud/auth.json
